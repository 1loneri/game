							<bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">true</bool><CoordinateFrame name="CFrame"><X>-56.0</X><Y>4.999999999999999</Y><Z>-1881.9100754630829</Z><R00>-1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>-1.0</R22></CoordinateFrame><Vector3 name="size"><X>3.346649450878356</X><Y>8.0</Y><Z>2.073288377114072</Z></Vector3><Vector3 name="InitialSize"><X>7.13417006</X><Y>17.0538807</Y><Z>4.41970158</Z></Vector3></Properties><Item class="SurfaceAppearance" referent="StoreSurface50"><Properties><token name="AlphaMode">0</token>
