							</Properties></Item></Item></Item></Item></Item><Item class="Camera" referent="RBX7045"><Properties><string name="Name">Camera</string><CoordinateFrame name="CFrame"><X>155</X><Y>72</Y><Z>-1725</Z><R00>0.7828232547561077</R00><R01>-0.127154240579229</R01><R02>0.6091137421826678</R02><R10>0.0</R10><R11>0.9788983409356276</R11><R12>0.20434783608708856</R12><R20>-0.6222441255753677</R20><R21>-0.15996823814806227</R21><R22>0.7663043853265821</R22></CoordinateFrame><token name="CameraType">5</token></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX7027"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX7028"><Properties><string name="Name">Underlayer</string></Properties><Item class="RemoteEvent" referent="RBX7029"><Properties><string name="Name">Action</string></Properties></Item><Item class="ModuleScript" referent="RBX7030"><Properties><string name="Name">Config</string><ProtectedString name="Source">local C = {}
C.Version = 6
C.StudioPersistence = false -- Play работает без публикации и API-доступа; true только для теста DataStore
C.SaveName = 'Underlayer_v1'
C.HelpPass = 0 -- game pass: автоматическая помощь выбранных малышей
C.SlotsPass = 0 -- game pass: всего три активных спутника вместо одного
C.EggProduct = 0 -- developer product: одно яйцо
C.DirectProducts = {Nova=0, Umbra=0, Sol=0} -- developer products: конкретный малыш
C.EggOdds = {{id='Nova',chance=60},{id='Umbra',chance=30},{id='Sol',chance=10}}
C.Missions={
 [0]={text='Получи щётку на учебной стойке',target='TrainingRack'},
 [1]={text='Очисти 3 блока пыли',target='TrainingPitMarker'},
 [2]={text='Получи скребок на стойке инструментов',target='TrainingRack'},
 [3]={text='Сними 2 блока твёрдого слоя',target='TrainingPitMarker'},
 [4]={text='Открой найденный кокон',target='TrainingNest'},
 [5]={text='Сдай добычу в учебном терминале',target='TrainingSell'},
 [6]={text='Заверши обучение у шлюза',target='TrainingExit'},
 [7]={text='Очисти 12 залежей первой экспедиции',target='SectorSign'},
 [8]={text='Восстанови генератор базы за 80 монет',target='BaseGenerator'},
 [9]={text='Исследуй участки и собирай коллекцию',target='SectorSign'},
}
C.Pets = {
 Dust={name='Пылик',color=Color3.fromRGB(172,183,189),kind='fluff',premium=false},
 Moss={name='Мохлик',color=Color3.fromRGB(124,175,145),kind='sprout',premium=false},
 Crystal={name='Кристик',color=Color3.fromRGB(133,191,208),kind='crystal',premium=false},
 Nova={name='Нова',color=Color3.fromRGB(184,148,240),kind='star',premium=true},
 Umbra={name='Умбра',color=Color3.fromRGB(106,134,198),kind='horns',premium=true},
 Sol={name='Сол',color=Color3.fromRGB(246,189,113),kind='sun',premium=true},
}
C.Tools = {
 {name='Щётка',cost=0,power=1,capacity=50},
 {name='Скребок',cost=140,power=2,capacity=100},
 {name='Бур',cost=650,power=4,capacity=200},
}
function C.Level(xp) return math.floor(math.sqrt(math.max(0,xp)/45))+1 end
function C.Stage(growth)
 if growth&gt;=50 then return 5 elseif growth&gt;=30 then return 4 elseif growth&gt;=15 then return 3 elseif growth&gt;=6 then return 2 end
 return 1
end
return C
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7031"><Properties><string name="Name">PetVisual</string><ProtectedString name="Source">-- Original geometric monster models: distinct anatomy, layered eyes and growth details.
local V={}
function V.Build(id,def,growth)
 local m=Instance.new('Model'); m.Name=id
 local g=math.clamp(growth,1,50); local scale=.52+g*.018
 local stage=g&gt;=50 and 5 or g&gt;=30 and 4 or g&gt;=15 and 3 or g&gt;=6 and 2 or 1
 local dark=Color3.fromRGB(27,34,46); local cream=Color3.fromRGB(232,222,198)
 local col=def.color
 local function shape(name,size,pos,color,kind,rot,material)
  local p=Instance.new(kind=='wedge' and 'WedgePart' or 'Part'); p.Name=name
  if kind=='ball' then p.Shape=Enum.PartType.Ball elseif kind=='cylinder' then p.Shape=Enum.PartType.Cylinder end
  p.Size=size*scale; p.CFrame=CFrame.new(pos*scale)*(rot or CFrame.new()); p.Color=color
  p.Material=material or Enum.Material.SmoothPlastic
  p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.CastShadow=true; p.Parent=m
  return p
 end
 local function ball(n,s,p,c) return shape(n,s,p,c,'ball') end
 local bodySize=(id=='Crystal' or id=='Sol') and Vector3.new(2,1.65,2.8) or Vector3.new(2.1,1.9,2.3)
 local body=ball('Torso',bodySize,Vector3.new(0,0,.35),col); m.PrimaryPart=body
 -- A separate head, jaw, muzzle, belly, four feet, toes and layered eyes.
 ball('Head',Vector3.new(2,1.65,1.65),Vector3.new(0,.62,-.95),col)
 ball('Muzzle',Vector3.new(1.3,.7,.75),Vector3.new(0,.16,-1.62),cream)
 ball('Belly',Vector3.new(1.45,1.25,.8),Vector3.new(0,-.12,-.55),col:Lerp(cream,.6))
 ball('Nose',Vector3.new(.25,.18,.18),Vector3.new(0,.35,-2),dark)
 shape('Mouth',Vector3.new(.34,.045,.055),Vector3.new(0,.02,-2.01),dark)
 for _,side in ipairs({-1,1}) do
  local x=side*.56
  ball('EyeSocket',Vector3.new(.62,.71,.35),Vector3.new(x,.83,-1.62),col:Lerp(dark,.24))
  ball('EyeWhite',Vector3.new(.47,.57,.23),Vector3.new(x,.85,-1.78),cream)
  ball('Iris',Vector3.new(.26,.4,.15),Vector3.new(x,.84,-1.89),dark)
  ball('EyeGlint',Vector3.new(.1,.13,.07),Vector3.new(x-.055,.95,-1.97),Color3.new(1,1,1))
  ball('Cheek',Vector3.new(.35,.16,.12),Vector3.new(side*.82,.3,-1.58),col:Lerp(Color3.fromRGB(228,146,155),.5))
  for _,z in ipairs({-.7,1.03}) do
   ball('Leg',Vector3.new(.58,.85,.65),Vector3.new(side*.86,-.68,z),col:Lerp(dark,.1))
   ball('Paw',Vector3.new(.7,.4,.94),Vector3.new(side*.87,-1.04,z-.16),col)
   for toe=-1,1 do ball('Claw',Vector3.new(.12,.12,.23),Vector3.new(side*.87+toe*.18,-1.04,z-.58),cream) end
  end
 end
 if id=='Dust' then
  for _,side in ipairs({-1,1}) do
   shape('TallEar',Vector3.new(.62,1.25+stage*.12,.52),Vector3.new(side*.77,1.73,-.62),col,'wedge',CFrame.Angles(0,side*.3,side*-.3))
   shape('EarInner',Vector3.new(.27,.8,.12),Vector3.new(side*.77,1.7,-.94),cream,'wedge')
   for i=1,3 do shape('CheekTuft',Vector3.new(.4,.45,.6),Vector3.new(side*(.96+i*.08),.35+i*.18,-.7),col,'wedge',CFrame.Angles(0,0,side*.7)) end
  end
  ball('TailBase',Vector3.new(.65,.65,1.4),Vector3.new(0,.1,1.85),col)
  shape('TailTip',Vector3.new(1.1,.85,1.3),Vector3.new(0,.45,2.45),cream,'wedge',CFrame.Angles(.4,0,0))
 elseif id=='Moss' then
  for i=1,3+stage do
   local a=i*math.pi*2/(3+stage)
   shape('LeafCrown',Vector3.new(.5,.25,1.25),Vector3.new(math.cos(a)*.55,1.35,math.sin(a)*.55-.2),Color3.fromRGB(74,137,94),'wedge',CFrame.Angles(-.4,a,0))
  end
  shape('Stem',Vector3.new(.25,.7,.25),Vector3.new(0,1.55,-.35),Color3.fromRGB(113,151,89))
  ball('Bud',Vector3.new(.65,.6,.65),Vector3.new(0,2,-.35),Color3.fromRGB(205,172,126))
  for _,side in ipairs({-1,1}) do shape('LeafEar',Vector3.new(.8,.25,1.3),Vector3.new(side*1.05,1,-.5),col,'wedge',CFrame.Angles(.4,side*.7,side*.6)) end
  for i=1,3 do ball('TailSegment',Vector3.new(.6-i*.1,.55-i*.08,.75),Vector3.new(0,.1+i*.2,1.4+i*.45),col) end
 elseif id=='Crystal' then
  shape('BackShell',Vector3.new(2.15,.75,2.25),Vector3.new(0,.65,.55),col:Lerp(dark,.2),'wedge')
  for i=1,2+stage do
   local x=(i%2==0 and -1 or 1)*.45; local z=.1+math.floor((i-1)/2)*.5
   shape('QuartzPlate',Vector3.new(.42,.75+stage*.15,.5),Vector3.new(x,1.2,z),col:Lerp(cream,.3),'wedge',CFrame.Angles(0,0,x*.35),Enum.Material.Neon)
  end
  for _,side in ipairs({-1,1}) do shape('HeadHorn',Vector3.new(.4,.9,.45),Vector3.new(side*.77,1.55,-.5),cream,'wedge',CFrame.Angles(-.4,0,side*.2)) end
  for i=1,3 do shape('ArmoredTail',Vector3.new(.8-i*.15,.55,1),Vector3.new(0,.1,1.3+i*.55),col,'wedge') end
 elseif id=='Nova' then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do shape('WingFeather',Vector3.new(.5,.2,1.7),Vector3.new(side*(1+i*.28),.6+i*.16,.15),col:Lerp(cream,i*.15),'wedge',CFrame.Angles(.2,side*.5,side*-.5)) end
   shape('CrescentEar',Vector3.new(.5,1.6,.6),Vector3.new(side*.8,1.65,-.6),col,'wedge',CFrame.Angles(.2,0,side*.4))
  end
  ball('ForeheadGem',Vector3.new(.32,.46,.2),Vector3.new(0,1.19,-1.77),Color3.fromRGB(240,212,143))
  for i=1,4 do ball('StarTail',Vector3.new(.5,.45,.6),Vector3.new(0,.2+i*.2,1.2+i*.4),col:Lerp(cream,i*.15)) end
 elseif id=='Umbra' then
  for _,side in ipairs({-1,1}) do
   shape('CurvedHornBase',Vector3.new(.5,1.1,.6),Vector3.new(side*.8,1.5,-.5),dark,'wedge',CFrame.Angles(-.4,0,side*.3))
   shape('HornTip',Vector3.new(.3,.85,.35),Vector3.new(side*1.02,2.15,-.3),cream,'wedge',CFrame.Angles(.5,0,side*.4))
   for i=1,stage do shape('BackSpine',Vector3.new(.35,.5,.5),Vector3.new(side*.55,.95,.1+i*.35),dark,'wedge') end
  end
  shape('LongTail',Vector3.new(.35,.4,2),Vector3.new(0,.1,2),col,'wedge',CFrame.Angles(.25,0,0))
  shape('SpadeTail',Vector3.new(.9,.25,.9),Vector3.new(0,.35,3),dark,'wedge')
 else
  for i=1,8+stage do
   local a=i*math.pi*2/(8+stage)
   shape('SunMane',Vector3.new(.42,.65,.5),Vector3.new(math.cos(a)*1.08,.65+math.sin(a)*1.02,-.78),col:Lerp(cream,.2),'wedge',CFrame.Angles(0,0,a-math.pi/2))
  end
  for i=1,3 do ball('Tail',Vector3.new(.5,.5,.8),Vector3.new(0,.2+i*.14,1.3+i*.5),col) end
  shape('FlameTip',Vector3.new(.8,1,.65),Vector3.new(0,.9,2.9),Color3.fromRGB(241,143,83),'wedge')
 end
 if stage&gt;=3 then for _,side in ipairs({-1,1}) do shape('ShoulderMark',Vector3.new(.15,.45,.6),Vector3.new(side*1.05,.1,-.1),cream,'wedge') end end
 if stage&gt;=4 then for i=1,3 do shape('Crest',Vector3.new(.3,.45,.5),Vector3.new(0,1.1,.1+i*.45),col:Lerp(cream,.4),'wedge') end end
 local gui=Instance.new('BillboardGui'); gui.Size=UDim2.fromOffset(160,30); gui.StudsOffset=Vector3.new(0,3.1*scale,0); gui.MaxDistance=35; gui.Parent=body
 local label=Instance.new('TextLabel'); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1; label.Text=def.name; label.Font=Enum.Font.GothamMedium; label.TextSize=12; label.TextColor3=cream; label.TextStrokeTransparency=.5; label.Parent=gui
 return m
end
return V
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7032"><Properties><string name="Name">Layout</string><ProtectedString name="Source">-- One layout shared by the editable place, source-only runtime and gameplay.
local L={}
L.Size=3072
L.Tile=64
L.SurfaceY=0
L.BlockSize=16
L.PatchCells=8
L.Layers=3
L.CampZ=-1240
L.TrainingZ=-1920
L.Zones={
 {name='01 / Тихая равнина',x=0,z=-1024},
 {name='02 / Пыльное море',x=448,z=-896},
 {name='03 / Старый разлом',x=-512,z=-832},
 {name='04 / Кратер Эхо',x=960,z=-448},
 {name='05 / Потерянный зонд',x=-1088,z=-320},
 {name='06 / Застывшая волна',x=128,z=-384},
 {name='07 / Дальний сектор',x=448,z=192},
 {name='08 / Глухая впадина',x=-384,z=256},
 {name='09 / Край тишины',x=1088,z=576},
 {name='10 / Тёмное море',x=-1088,z=768},
 {name='11 / Последний сигнал',x=0,z=1024},
 {name='12 / Северная экспедиция',x=768,z=1152},
}
function L.LayerY(layer) function L.TileCells(cx,cz)
 local cells={}
 for ix=0,3 do for iz=0,3 do for layer=1,3 do
  table.insert(cells,{x=cx-24+ix*16,z=cz-24+iz*16,layer=layer})
 end end end
 return cells
end
return L.SurfaceY-1.25-(layer-1)*2.5 end
function L.InPatch(x,z,margin)
 local half=L.PatchCells*L.BlockSize/2+(margin or 0)
 for _,zone in ipairs(L.Zones) do
  if math.abs(x-zone.x)&lt;half and math.abs(z-zone.z)&lt;half then return true end
 end
 return false
end
function L.TileCells(cx,cz)
 local cells={}
 for ix=0,3 do for iz=0,3 do for layer=1,3 do
  table.insert(cells,{x=cx-24+ix*16,z=cz-24+iz*16,layer=layer})
 end end end
 return cells
end
return L
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX7033"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX7034"><Properties><string name="Name">Profile</string><ProtectedString name="Source">-- Session lease + serialized writes. Studio can run offline; purchases cannot.
local DSS=game:GetService('DataStoreService')
local Run=game:GetService('RunService')
local Http=game:GetService('HttpService')
local C=require(game.ReplicatedStorage.Underlayer.Config)
-- DataStore acquisition itself can throw in an unpublished place.
local store
local acquired, result=pcall(function()
 if Run:IsStudio() and not C.StudioPersistence then return nil end
 return DSS:GetDataStore(C.SaveName)
end)
if acquired then store=result end
local owner=game.JobId~='' and game.JobId or Http:GenerateGUID(false)
local P={}; P.Live={}
local function copy(x)
 if type(x)~='table' then return x end
 local y={}; for k,v in pairs(x) do y[k]=copy(v) end; return y
end
local function fresh()
 return {coins=0,xp=0,bag=0,tool=1,pets={},equipped={},tutorial={step=0,soft=0,hard=0,field=0},eggs=0,receipts={}}
end
function P.Load(player)
 local success, record=false,nil
 if store then success, record=pcall(function()
  return store:UpdateAsync('u'..player.UserId,function(old)
   old=old or {data=fresh()}
   if old.owner and old.owner~=owner and (old.lease or 0)&gt;os.time() then return nil end
   old.owner=owner; old.lease=os.time()+180; return old
  end)
 end) end
 if success and not record then return nil,'Твой профиль ещё открыт на другом сервере. Попробуй через минуту.' end
 if not success and not Run:IsStudio() then return nil,'Не удалось загрузить сохранение. Попробуй снова позже.' end
 local state={data=success and record.data or fresh(),busy=false,offline=not success,owner=owner}
 local d=state.data; d.receipts=d.receipts or {}; d.eggs=d.eggs or 0; d.tutorial=d.tutorial or {step=0,soft=0,hard=0,field=0}
 P.Live[player]=state
 return state
end
function P.Commit(player, transform, release)
 local s=P.Live[player]; if not s or s.busy then return false end
 if s.offline then return false end
 s.busy=true
 local snapshot=copy(s.data)
 local ok,result=pcall(function()
  return store:UpdateAsync('u'..player.UserId,function(old)
   if not old or old.owner~=owner then return nil end
   local nextData=copy(snapshot)
   -- Purchase receipts are saved atomically with their grant.
   nextData.receipts=copy(old.data.receipts or {})
   if transform then transform(nextData) end
   local result={data=nextData,lease=release and 0 or os.time()+180}
   if not release then result.owner=owner end
   return result
  end)
 end)
 if ok and result then s.data=result.data end
 s.busy=false
 if not ok or not result then
  s.saveFailed=true
  if not release then player:Kick('Сохранение недоступно. Войди снова, чтобы защитить прогресс.') end
  return false
 end
 return true
end
function P.WaitSave(player,release)
 local s=P.Live[player]; if not s or s.offline then return end
 local deadline=os.clock()+20
 while s.busy and os.clock()&lt;deadline do task.wait(.1) end
 if not s.busy then P.Commit(player,nil,release) end
end
function P.Copy(x) return copy(x) end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7035"><Properties><string name="Name">World</string><ProtectedString name="Source">local Layout=require(script.Parent.Layout)
local W={}
function W.Build()
 local old=workspace:FindFirstChild('UnderlayerWorld')
 if old then
  local terminal=old:FindFirstChild('Terminal'); local bench=old:FindFirstChild('Workbench')
  if terminal and bench then
   local sell=terminal:FindFirstChildOfClass('ProximityPrompt'); local upgrade=bench:FindFirstChildOfClass('ProximityPrompt')
   if sell and upgrade then return {Root=old,Sell=sell,Upgrade=upgrade} end
  end
  old:Destroy()
 end
 local root=Instance.new('Folder'); root.Name='UnderlayerWorld'; root.Parent=workspace
 local function block(name,size,pos,color,material)
  local p=Instance.new('Part'); p.Name=name; p.Size=size; p.Position=pos; p.Anchored=true
  p.Color=color; p.Material=material or Enum.Material.Slate; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=root; return p
 end
 local dust=Color3.fromRGB(135,137,140)
 local rock=Color3.fromRGB(98,102,109)
 local metal=Color3.fromRGB(69,78,86)
 local warm=Color3.fromRGB(227,186,110)
 -- Waypoint anchors remain for the HUD, without floating world billboards.
 local function sign(parent,txt)
  parent.Transparency=1; parent.CanCollide=false; parent.CanQuery=false
 end
 local function lamp(x,y,z)
  block('MarkerPost',Vector3.new(.6,3,.6),Vector3.new(x,y+1.5,z),metal,Enum.Material.Metal)
  local glow=block('MarkerLamp',Vector3.new(.9,.6,.9),Vector3.new(x,y+3.1,z),warm,Enum.Material.Neon)
  local light=Instance.new('PointLight'); light.Color=warm; light.Range=18; light.Brightness=.6; light.Parent=glow
 end
 local function sellTerminal(name,x,z)
  local p=block(name,Vector3.new(6,4,4),Vector3.new(x,2,z),metal,Enum.Material.Metal)
  local screen=block('DepotScreen',Vector3.new(4,1.5,.2),Vector3.new(x,3,z-2.1),Color3.fromRGB(171,202,194),Enum.Material.Neon)
  local prompt=Instance.new('ProximityPrompt'); prompt.Name='SellPrompt'; prompt.ActionText='Сдать ресурсы'; prompt.ObjectText='Пункт экспедиции'
  prompt.HoldDuration=.25; prompt.MaxActivationDistance=12; prompt.Parent=p
  return prompt
 end
 local lighting=game:GetService('Lighting')
 lighting.ClockTime=0; lighting.Brightness=0; lighting.ExposureCompensation=0; lighting.Ambient=Color3.fromRGB(0,0,0); lighting.OutdoorAmbient=Color3.fromRGB(0,0,0)
 lighting.FogColor=Color3.fromRGB(12,16,25); lighting.FogStart=1150; lighting.FogEnd=2800
 lighting.EnvironmentDiffuseScale=0; lighting.EnvironmentSpecularScale=0
 -- No atmospheric haze: this is an airless moon with a visible distant horizon.
 lighting.GlobalShadows=true
 local sky=Instance.new('Sky'); sky.Name='LunarSky'; sky.StarCount=2600; sky.CelestialBodiesShown=false
 sky.SkyboxBk=''; sky.SkyboxDn=''; sky.SkyboxFt=''; sky.SkyboxLf=''; sky.SkyboxRt=''; sky.SkyboxUp=''; sky.Parent=lighting
 -- Editor-visible ground around the central map. Runtime Terrain replaces these
 -- preview slabs. A station-sized cutout prevents floor z-fighting in either mode.
 local extent=4096; local core=1536; local stationZ=Layout.TrainingZ
 local function preview(x0,x1,z0,z1)
  block('OuterGroundPreview',Vector3.new(x1-x0,9,z1-z0),Vector3.new((x0+x1)/2,-4.6,(z0+z1)/2),dust,Enum.Material.Sand)
 end
 preview(-extent,-100,-extent,-core); preview(100,extent,-extent,-core)
 preview(-100,100,-extent,stationZ-85); preview(-100,100,stationZ+135,-core)
 preview(-extent,extent,core,extent); preview(-extent,-core,-core,core); preview(core,extent,-core,core)
 block('DeepBedrock',Vector3.new(Layout.Size+64,8,Layout.Size+64),Vector3.new(0,-13,0),rock)
 local half=Layout.Size/2
 for ix=0,Layout.Size/Layout.Tile-1 do
  for iz=0,Layout.Size/Layout.Tile-1 do
   local x=-half+Layout.Tile/2+ix*Layout.Tile; local z=-half+Layout.Tile/2+iz*Layout.Tile
   if not Layout.InPatch(x,z) then
    local shade=131+(ix*7+iz*11)%12
    block('LunarRegolith',Vector3.new(Layout.Tile,9,Layout.Tile),Vector3.new(x,-4.5,z),Color3.fromRGB(shade,shade+1,shade+4),Enum.Material.Sand)
   end
  end
 end
 local deposits=Instance.new('Folder'); deposits.Name='Deposits'; deposits.Parent=root
 for zi,zone in ipairs(Layout.Zones) do
  for ix=0,Layout.PatchCells-1 do for iz=0,Layout.PatchCells-1 do for layer=1,Layout.Layers do
   local x=zone.x-64+8+ix*Layout.BlockSize; local z=zone.z-64+8+iz*Layout.BlockSize
   local color=layer==1 and dust or (layer==2 and rock or Color3.fromRGB(101,98,116))
   if not (math.abs(x-zone.x)&lt;16 and z&gt;=zone.z+32) then
   local b=block('Layer'..layer,Vector3.new(Layout.BlockSize,2.5,Layout.BlockSize),Vector3.new(x,Layout.LayerY(layer),z),color,layer==1 and Enum.Material.Sand or Enum.Material.Slate)
   b.Parent=deposits
   end
  end end end
  local plate=block('SectorSign',Vector3.new(19,4,.4),Vector3.new(zone.x,3,zone.z-75),metal,Enum.Material.Metal)
  sign(plate,zone.name)
  sellTerminal('FieldDepot'..zi,zone.x+82,zone.z-66)
  for _,side in ipairs({-1,1}) do lamp(zone.x+side*71,0,zone.z-65); lamp(zone.x+side*71,0,zone.z+65) end
  -- Permanent escape steps, cut into a strip at the south edge of each dig site.
  for i=0,5 do
   local top=-7.5+i*1.5
   local step=block('EscapeStep',Vector3.new(12,1.5,3),Vector3.new(zone.x,top-.75,zone.z+47+i*3),metal,Enum.Material.Concrete)
   step.Parent=root
  end
 end
 -- Broad impact craters: a low polygonal inner wall and an outer sloping rim.
 local craters={{x=-190,z=-370,r=95,h=12},{x=335,z=8,r=120,h=16},{x=-390,z=48,r=100,h=11},{x=280,z=550,r=110,h=13},{x=-500,z=530,r=95,h=10},{x=150,z=-610,r=68,h=8},{x=-310,z=-1120,r=145,h=16},{x=1050,z=-1050,r=175,h=22},{x=-1100,z=150,r=160,h=20},{x=1100,z=960,r=180,h=24},{x=-580,z=1100,r=195,h=21},{x=420,z=720,r=130,h=17}}
 for ci,c in ipairs(craters) do
  local n=48
  for i=0,n-1 do
   local a=i*math.pi*2/n
   for _,outer in ipairs({false,true}) do
    local span=outer and 40 or 28
    local r=c.r+(outer and span/2 or -span/2)
    local y=c.h/2
    local slope=math.atan(c.h/span)*(outer and 1 or -1)
    local px,pz=c.x+math.cos(a)*r,c.z+math.sin(a)*r
    if not Layout.InPatch(px,pz,32) then
    local segment=block('CraterRim'..ci,Vector3.new((2*math.pi*r/n)+2,1.4,math.sqrt(span*span+c.h*c.h)),Vector3.new(c.x+math.cos(a)*r,y,c.z+math.sin(a)*r),Color3.fromRGB(117+ci%3*4,120+ci%3*4,126+ci%3*4))
    segment.CFrame=segment.CFrame*CFrame.Angles(0,math.pi/2-a,0)*CFrame.Angles(slope,0,0)
    end
   end
  end
 end
 -- Long-distance silhouettes, outside the playable plain; no narrow rock corridor.
 for i=1,96 do
  local a=i*math.pi*2/96; local radius=2000+math.sin(i*4.1)*190
  local m=block('HorizonMassif',Vector3.new(150+i%4*30,90+i%5*22,170+i%3*35),Vector3.new(math.cos(a)*radius,15,math.sin(a)*radius),Color3.fromRGB(73+i%3*5,78+i%3*5,88+i%3*5))
  m.Shape=Enum.PartType.Ball; m.CFrame=m.CFrame*CFrame.Angles(.18,i*.7,.12)
 end
 -- Scattered boulders, with the main route and excavation sites kept clear.
 for i=1,330 do
  local x=math.sin(i*127.1)*1450; local z=math.sin(i*311.7)*1450
  if not Layout.InPatch(x,z) and math.abs(x)&gt;95 and math.abs(z-Layout.CampZ)&gt;55 then
   local s=2+i%8
   local stone=block('LunarBoulder',Vector3.new(s*1.4,s,s*1.2),Vector3.new(x,s*.2,z),Color3.fromRGB(99+i%5*4,102+i%5*4,109+i%5*4))
   stone.Shape=Enum.PartType.Ball; stone.CFrame=stone.CFrame*CFrame.Angles(i*.8,i*.3,i*.12)
  end
 end
 -- Small expedition camp, dwarfed by the surrounding landscape.
 local cz=Layout.CampZ
 block('Camp',Vector3.new(92,1,56),Vector3.new(0,.5,cz),metal,Enum.Material.Metal)
 local spawn=Instance.new('SpawnLocation'); spawn.Name='CampSpawn'; spawn.Size=Vector3.new(7,1,7); spawn.Position=Vector3.new(0,1.5,cz); spawn.Anchored=true; spawn.Neutral=true; spawn.Transparency=1; spawn.Parent=root
 local prompt=sellTerminal('Terminal',-18,cz)
 local bench=block('Workbench',Vector3.new(8,3,4),Vector3.new(18,2.5,cz),Color3.fromRGB(104,98,87),Enum.Material.Metal)
 local up=Instance.new('ProximityPrompt'); up.ActionText='Улучшить инструмент'; up.ObjectText='Мастерская'; up.HoldDuration=.25; up.MaxActivationDistance=12; up.Parent=bench
 for _,x in ipairs({-34,34}) do lamp(x,1,cz-12); lamp(x,1,cz+18) end
 local shelter=block('Habitat',Vector3.new(24,13,18),Vector3.new(-25,7,cz-25),Color3.fromRGB(194,196,193),Enum.Material.Metal)
 block('HabitatDoor',Vector3.new(5,8,.5),Vector3.new(-25,4.5,cz-15.7),metal,Enum.Material.Metal)
 for _,x in ipairs({-31,-19}) do block('HabitatWindow',Vector3.new(3,2,.3),Vector3.new(x,8,cz-15.7),warm,Enum.Material.Neon) end
 local dish=block('Dish',Vector3.new(13,2,13),Vector3.new(28,20,cz-18),Color3.fromRGB(168,174,179),Enum.Material.Metal)
 dish.Shape=Enum.PartType.Ball; dish.CFrame=dish.CFrame*CFrame.Angles(.65,0,.2)
 block('DishMast',Vector3.new(1,18,1),Vector3.new(28,10,cz-18),metal,Enum.Material.Metal)
 for i=1,5 do block('Cargo',Vector3.new(4,3,4),Vector3.new(35+(i%2)*5,2,cz-12+math.floor(i/2)*5),Color3.fromRGB(151,140,111),Enum.Material.Metal) end
 local board=block('MissionSign',Vector3.new(22,5,.4),Vector3.new(0,5,cz+22),metal,Enum.Material.Metal)
 sign(board,'UNDERLAYER / 07\nРАСКОПКИ ВПЕРЕДИ')
 -- Route lamps lead to the first site, not a wall around the map.
 for z=cz+50,Layout.Zones[1].z-85,40 do lamp(-10,0,z) end
 -- A distant probe rewards navigation with a recognizable landmark.
 block('LostProbe',Vector3.new(9,6,9),Vector3.new(Layout.Zones[5].x,4,Layout.Zones[5].z-85),Color3.fromRGB(181,179,169),Enum.Material.Metal)
 for _,x in ipairs({-1,1}) do block('SolarPanel',Vector3.new(16,.3,9),Vector3.new(Layout.Zones[5].x+x*16,6,Layout.Zones[5].z-85),Color3.fromRGB(43,57,79),Enum.Material.Metal) end
 -- Enclosed training room, with a shallow practice pit and a solid bottom.
 local tz=Layout.TrainingZ
 block('TrainingFoundation',Vector3.new(144,8,128),Vector3.new(0,-9,tz),Color3.fromRGB(76,83,91),Enum.Material.Concrete)
 for ix=0,15 do for iz=0,13 do
  local x=-64+4+ix*8; local z=tz-56+4+iz*8
  if not (x&gt;=8 and x&lt;40 and z&gt;=tz-16 and z&lt;tz+16) then
   block('TrainingFloor',Vector3.new(8,5,8),Vector3.new(x,-2.5,z),Color3.fromRGB(118,127,133),Enum.Material.Concrete)
  end
 end end
 -- Chamfered white station shell, orange banding, recessed glazing and vents.
 local white=Color3.fromRGB(205,208,212)
 local orange=Color3.fromRGB(224,148,55)
 local trim=Color3.fromRGB(44,49,56)
 local outline={{-52,-64},{52,-64},{72,-44},{72,44},{52,64},{-52,64},{-72,44},{-72,-44}}
 local function detail(name,size,x,y,z,color,material,yaw)
  local p=block(name,size,Vector3.new(x,y,tz+z),color,material or Enum.Material.SmoothPlastic)
  if yaw then p.CFrame=p.CFrame*CFrame.Angles(0,yaw,0) end
  return p
 end
 for i,a in ipairs(outline) do
  local b=outline[i%#outline+1]
  local dx,dz=b[1]-a[1],b[2]-a[2]; local len=math.sqrt(dx*dx+dz*dz)
  local tx,tt=dx/len,dz/len; local nx,nz=tt,-tx; local yaw=-math.atan2(dz,dx)
  local cx,cz=(a[1]+b[1])/2,(a[2]+b[2])/2
  local function face(name,w,h,depth,u,y,out,color,mat)
   return detail(name,Vector3.new(w,h,depth),cx+tx*u+nx*out,y,cz+tt*u+nz*out,color,mat,yaw)
  end
  local front=i==5
  local bays=math.max(1,math.floor(len/20)); local width=len/bays
  face('StationLowerBand',len-.12,.65,.22,0,7.7,1.16,orange)
  face('StationUpperBand',len-.12,.65,.22,0,35.1,1.16,orange)
  face('StationCrown',len+.25,2,3.4,0,44.6,.15,white)
  face('StationDarkRoofLip',len-.12,.25,2.8,0,45.75,.15,trim)
  for j=0,bays-1 do
   local u=-len/2+width*(j+.5)
   if not (front and math.abs(u)&lt;width*.45) then
    face('StationPanelBase',width-.1,11,2,u,5.5,0,white)
    face('StationPanelHeader',width-.1,11,2,u,38.5,0,white)
    local window=3.5
    for _,side in ipairs({-1,1}) do
     face('StationPanelPier',(width-window)/2-.04,22,2,u+side*(width+window)/4,22,0,white)
    end
    face('StationWindow',window,21.7,.3,u,22,-.05,Color3.fromRGB(82,125,153),Enum.Material.Glass)
    for _,side in ipairs({-1,1}) do
     face('StationWindowFrame',.34,22.3,.42,u+side*(window/2+.15),22,.87,trim)
    end
    for _,yy in ipairs({10.95,33.05}) do face('StationWindowFrame',window+.6,.34,.42,u,yy,.87,trim) end
    -- Vent housing is physically in front of the wall, not coplanar with it.
    face('StationVent',width-4,3.3,.32,u,39.8,1.25,trim)
    for slat=0,5 do face('StationVentSlat',width-4.5,.14,.18,u,38.55+slat*.48,1.51,Color3.fromRGB(96,100,105)) end
    if j%2==0 then
     face('StationLowerVent',width-5,2,.32,u,3.8,1.25,trim)
     for slat=0,3 do face('StationVentSlat',width-5.5,.12,.18,u,3.1+slat*.45,1.51,Color3.fromRGB(96,100,105)) end
    end
   else
    face('StationDoorHeader',width-.1,25,2,u,31.5,0,white)
    face('StationDoorFrame',14,1.2,2.9,u,15.7,.35,trim)
    for _,side in ipairs({-1,1}) do
     face('StationDoorFrame',1.2,15.3,2.9,u+side*6.4,7.65,.35,trim)
     face('StationDoor',5.65,14.8,.7,u+side*2.91,7.4,.45,white)
     face('StationDoorGlass',.8,6,.18,u+side*2.4,10.3,.92,Color3.fromRGB(83,128,155))
     face('StationDoorAccent',5.65,.38,.18,u+side*2.91,3.2,.92,orange)
    end
   end
  end
  -- Every external light has visible housing and a downward-facing lens.
  local fixture=face('StationExteriorLamp',2,.7,2,0,41,6,trim)
  local lens=face('StationExteriorLampLens',1.4,.12,1.4,0,40.57,6,Color3.fromRGB(247,222,179),Enum.Material.Neon)
  local spot=Instance.new('SpotLight'); spot.Name='StationLamp'; spot.Face=Enum.NormalId.Bottom
  spot.Color=Color3.fromRGB(248,226,191); spot.Angle=105; spot.Range=65; spot.Brightness=2; spot.Shadows=true; spot.Parent=lens
 end
 detail('StationRoof',Vector3.new(104,1.6,128),0,44,0,white)
 detail('StationRoofWing',Vector3.new(20,1.6,88),62,44,0,white)
 detail('StationRoofWing',Vector3.new(20,1.6,88),-62,44,0,white)
 for _,c in ipairs({{62,54,math.pi},{-62,54,math.pi/2},{62,-54,-math.pi/2},{-62,-54,0}}) do
  local wedge=Instance.new('WedgePart'); wedge.Name='StationRoofCorner'; wedge.Size=Vector3.new(1.6,20,20)
  wedge.CFrame=CFrame.new(c[1],44,tz+c[2])*CFrame.Angles(0,c[3],0)*CFrame.Angles(0,0,math.pi/2)
  wedge.Anchored=true; wedge.Color=white; wedge.Material=Enum.Material.SmoothPlastic; wedge.Parent=root
 end
 for _,x in ipairs({-38,38}) do for _,z in ipairs({-29,29}) do
  local housing=detail('StationCeilingFixture',Vector3.new(12,.5,3),x,41,z,trim)
  local lens=detail('StationCeilingLens',Vector3.new(11,.15,2),x,40.63,z,Color3.fromRGB(231,239,229),Enum.Material.Neon)
  local light=Instance.new('SpotLight'); light.Face=Enum.NormalId.Bottom; light.Angle=110; light.Range=68; light.Brightness=2.7
  light.Color=Color3.fromRGB(229,236,225); light.Shadows=true; light.Parent=lens
 end end
 -- Exterior steps and apron do not extend underneath the excavation pit.
 for i=0,4 do
  local y=-i
  detail('StationEntryStep',Vector3.new(30,1,3),0,y-.5,66+i*3,Color3.fromRGB(122,128,134),Enum.Material.Concrete)
 end
 for i=1,5 do
  detail('StationOuterStep',Vector3.new(30,1,3),0,-5+i-.5,118+i*3,Color3.fromRGB(122,128,134),Enum.Material.Concrete)
 end
 detail('StationApron',Vector3.new(180,3,42),0,-6.5,100,Color3.fromRGB(103,109,118),Enum.Material.Concrete)
 block('StationLunarPad',Vector3.new(320,8,300),Vector3.new(0,-13,tz),rock)
 local function interact(name,pos,txt)
  local p=block(name,Vector3.new(7,4,4),pos,metal,Enum.Material.Metal)
  local pp=Instance.new('ProximityPrompt'); pp.Name='TeachPrompt'; pp.ActionText=txt; pp.ObjectText='Учебный отдел'; pp.MaxActivationDistance=12; pp.HoldDuration=.25; pp.Parent=p
  local panel=block(name..'Label',Vector3.new(10,2,.3),pos+Vector3.new(0,4,0),metal,Enum.Material.Metal); sign(panel,txt)
  return p
 end
 interact('TrainingRack',Vector3.new(-45,2,tz-30),'Получить инструмент')
 interact('TrainingNest',Vector3.new(48,2,tz+4),'Осмотреть кокон')
 interact('TrainingSell',Vector3.new(-45,2,tz+27),'Сдать учебную добычу')
 local gate=interact('TrainingExit',Vector3.new(0,3,tz+56),'Завершить обучение')
 gate.Transparency=1; gate.CanCollide=false; gate.CanQuery=false
 local pit=block('TrainingPitMarker',Vector3.new(22,3,.4),Vector3.new(24,4,tz+20),metal,Enum.Material.Metal); sign(pit,'УЧЕБНЫЙ УЧАСТОК / ЛКМ')
 for ix=0,3 do for iz=0,3 do for layer=1,2 do
  local part=block('Layer'..layer,Vector3.new(8,2.5,8),Vector3.new(12+ix*8,Layout.LayerY(layer),tz-12+iz*8),layer==1 and dust or rock,Enum.Material.Sand)
  part.Parent=deposits
 end end end
 local intro=block('TrainingInstructions',Vector3.new(34,8,.4),Vector3.new(-15,9,tz-55),metal,Enum.Material.Metal)
 sign(intro,'УЧЕБНЫЙ ОТДЕЛ / 07\nПОЛУЧИ ЩЁТКУ → ОЧИСТИ УЧАСТОК → НАЙДИ КОКОН')
 local generator=block('BaseGenerator',Vector3.new(10,6,7),Vector3.new(-52,3,cz+28),Color3.fromRGB(97,101,91),Enum.Material.Metal)
 local repair=Instance.new('ProximityPrompt'); repair.Name='TeachPrompt'; repair.ActionText='Восстановить генератор'; repair.ObjectText='База / 80 монет'; repair.HoldDuration=1; repair.MaxActivationDistance=14; repair.Parent=generator
 spawn.Position=Vector3.new(-25,2,tz)
 return {Root=root,Sell=prompt,Upgrade=up}
end
return W
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7036"><Properties><string name="Name">Layout</string><ProtectedString name="Source">-- One layout shared by the editable place, source-only runtime and gameplay.
local L={}
L.Size=3072
L.Tile=64
L.SurfaceY=0
L.BlockSize=16
L.PatchCells=8
L.Layers=3
L.CampZ=-1240
L.TrainingZ=-1920
L.Zones={
 {name='01 / Тихая равнина',x=0,z=-1024},
 {name='02 / Пыльное море',x=448,z=-896},
 {name='03 / Старый разлом',x=-512,z=-832},
 {name='04 / Кратер Эхо',x=960,z=-448},
 {name='05 / Потерянный зонд',x=-1088,z=-320},
 {name='06 / Застывшая волна',x=128,z=-384},
 {name='07 / Дальний сектор',x=448,z=192},
 {name='08 / Глухая впадина',x=-384,z=256},
 {name='09 / Край тишины',x=1088,z=576},
 {name='10 / Тёмное море',x=-1088,z=768},
 {name='11 / Последний сигнал',x=0,z=1024},
 {name='12 / Северная экспедиция',x=768,z=1152},
}
function L.LayerY(layer) function L.TileCells(cx,cz)
 local cells={}
 for ix=0,3 do for iz=0,3 do for layer=1,3 do
  table.insert(cells,{x=cx-24+ix*16,z=cz-24+iz*16,layer=layer})
 end end end
 return cells
end
return L.SurfaceY-1.25-(layer-1)*2.5 end
function L.InPatch(x,z,margin)
 local half=L.PatchCells*L.BlockSize/2+(margin or 0)
 for _,zone in ipairs(L.Zones) do
  if math.abs(x-zone.x)&lt;half and math.abs(z-zone.z)&lt;half then return true end
 end
 return false
end
function L.TileCells(cx,cz)
 local cells={}
 for ix=0,3 do for iz=0,3 do for layer=1,3 do
  table.insert(cells,{x=cx-24+ix*16,z=cz-24+iz*16,layer=layer})
 end end end
 return cells
end
return L
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7037"><Properties><string name="Name">TerrainWorld</string><ProtectedString name="Source">-- Native Terrain outside the dig grid; no floating rectangular platform edge.
local T={}
function T.Build(world)
 if world:GetAttribute('OuterTerrainReady') then return end
 local terrain=workspace.Terrain
 local core=1536; local extent=4096
 local material=Enum.Material.Sand
 terrain:SetMaterialColor(material,Color3.fromRGB(126,129,136))
 terrain:SetMaterialColor(Enum.Material.Rock,Color3.fromRGB(98,104,113))
 local tz=require(script.Parent.Layout).TrainingZ
 local written=0
 local function fill(x0,x1,z0,z1)
  -- Bounded batches avoid oversized native Terrain operations.
  for x=x0,x1-1,512 do for z=z0,z1-1,512 do
   local right=math.min(x+512,x1); local far=math.min(z+512,z1)
   terrain:FillBlock(CFrame.new((x+right)/2,-16,(z+far)/2),Vector3.new(right-x,32,far-z),material)
   written=written+1; if written%8==0 then task.wait() end
  end end
 end
 -- Do not temporarily fill the room while generating the northern landscape.
 terrain:FillBlock(CFrame.new(0,20,tz+25),Vector3.new(200,80,220),Enum.Material.Air)
 fill(-extent,-100,-extent,-core); fill(100,extent,-extent,-core)
 fill(-100,100,-extent,tz-85); fill(-100,100,tz+135,-core)
 fill(-extent,extent,core,extent)
 fill(-extent,-core,-core,core)
 fill(core,extent,-core,core)
 for i=1,180 do
  local x=math.sin(i*127.1)*3650; local z=math.sin(i*311.7)*3650
  local radius=70+(i%7)*14
  if math.max(math.abs(x),math.abs(z))&gt;core+radius+100 and (Vector3.new(x,0,z)-Vector3.new(0,0,tz)).Magnitude&gt;radius+220 then
   terrain:FillBall(Vector3.new(x,-radius*.76,z),radius,i%4==0 and Enum.Material.Rock or material)
   if i%6==0 then terrain:FillBall(Vector3.new(x+radius*.5,22,z),32,Enum.Material.Air) end
  end
  if i%6==0 then task.wait() end
 end
 for _,p in ipairs(world:GetChildren()) do if p.Name=='OuterGroundPreview' then p:Destroy() end end
 world:SetAttribute('OuterTerrainReady',true)
end
return T
</ProtectedString></Properties></Item><Item class="Script" referent="RBX7038"><Properties><string name="Name">UnderlayerServer</string><ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Market=game:GetService('MarketplaceService')
local Policy=game:GetService('PolicyService')
local Run=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local F=RS:WaitForChild('Underlayer')
local C=require(F.Config); local Visual=require(F.PetVisual)
local Layout=require(script.Parent.Layout)
-- Visible world must never depend on persistence initialization.
local world=require(script.Parent.World).Build()
local Profile=require(script.Parent.Profile)
local event=F.Action
local rng=Random.new()
local sessions={}
local blocks=world.Root:FindFirstChild('Deposits')
if not blocks then blocks=Instance.new('Folder'); blocks.Name='Deposits'; blocks.Parent=world.Root end
local petsFolder=Instance.new('Folder'); petsFolder.Name='Companions'; petsFolder.Parent=world.Root
local function tell(p,message) if p.Parent then event:FireClient(p,'message',message) end end
local function rootOf(p)
 local ch=p.Character; local h=ch and ch:FindFirstChildOfClass('Humanoid')
 return h and h.Health&gt;0 and ch:FindFirstChild('HumanoidRootPart') or nil
end
local function state(p)
 local s=Profile.Live[p]; if s and not s.busy and not s.saveFailed then return s.data end
end
local function sync(p)
 local s=Profile.Live[p]; local u=sessions[p]
 if not s or not u then return end
 local d=Profile.Copy(s.data); d.receipts=nil
 d.level=C.Level(d.xp); d.help=u.help; d.slots=u.slots and 3 or 1
 d.eggAllowed=u.policy==true and not s.offline
 d.offline=s.offline; d.configured=C.EggProduct&gt;0
 event:FireClient(p,'data',d)
end
local function rebuild(p)
 local u=sessions[p]; local d=Profile.Live[p] and Profile.Live[p].data
 if not u or not d then return end
 for _,model in ipairs(u.models) do model:Destroy() end; u.models={}
 local root=rootOf(p)
 for i,id in ipairs(d.equipped) do
  if i&gt;(u.slots and 3 or 1) then break end
  local pet=d.pets[id]
  if pet and C.Pets[id] then
   local def=table.clone(C.Pets[id])
   if pet.fragments&gt;=5 then def.color=def.color:Lerp(Color3.new(1,1,1),.45) end
   local model=Visual.Build(id,def,pet.growth)
   model.Parent=petsFolder
   model:PivotTo(root and root.CFrame*CFrame.new(i*3,0,4) or CFrame.new(0,6,-45))
   table.insert(u.models,model)
  end
 end
end
local function refreshEntitlements(p)
 local u=sessions[p]; if not u then return end
 for _,kind in ipairs({'Help','Slots'}) do
  local id=kind=='Help' and C.HelpPass or C.SlotsPass
  if id&gt;0 then
   local ok,owns=pcall(Market.UserOwnsGamePassAsync,Market,p.UserId,id)
   if ok then u[string.lower(kind)]=owns end
  end
 end
 sync(p); rebuild(p)
end
local function giveTool(p)
 local d=state(p); if not d then return end
 local backpack=p:FindFirstChildOfClass('Backpack'); if not backpack then return end
 for _,container in ipairs({backpack,p.Character}) do
  if container then for _,obj in ipairs(container:GetChildren()) do if obj:IsA('Tool') and obj:GetAttribute('UnderlayerTool') then obj:Destroy() end end end
 end
 local tool=Instance.new('Tool'); tool.Name=C.Tools[d.tool].name; tool.CanBeDropped=false; tool:SetAttribute('UnderlayerTool',true)
 local handle=Instance.new('Part'); handle.Name='Handle'; handle.Size=Vector3.new(.28,2,.28); handle.Material=Enum.Material.Metal; handle.Color=Color3.fromRGB(103,119,127); handle.CanCollide=false; handle.Massless=true; handle.Parent=tool
 local function piece(name,size,offset,color,wedge)
  local part=Instance.new(wedge and 'WedgePart' or 'Part'); part.Name=name; part.Size=size; part.CFrame=handle.CFrame*CFrame.new(offset)
  part.Color=color; part.Material=Enum.Material.SmoothPlastic; part.CanCollide=false; part.Massless=true; part.Parent=tool
  local weld=Instance.new('WeldConstraint'); weld.Part0=handle; weld.Part1=part; weld.Parent=part
 end
 if d.tool==1 then
  piece('BrushHead',Vector3.new(1.3,.3,.65),Vector3.new(0,1,0),Color3.fromRGB(174,143,97))
  for i=-3,3 do piece('Bristles',Vector3.new(.12,.5,.5),Vector3.new(i*.17,1.35,0),Color3.fromRGB(64,69,73)) end
 elseif d.tool==2 then piece('ScraperBlade',Vector3.new(1.5,.3,1),Vector3.new(0,1,0),Color3.fromRGB(191,203,208),true)
 else piece('DrillMotor',Vector3.new(.9,.9,1.4),Vector3.new(0,.7,0),Color3.fromRGB(184,147,90)); piece('DrillTip',Vector3.new(.45,1.2,.45),Vector3.new(0,1.6,0),Color3.fromRGB(190,204,210),true) end
 tool.Grip=CFrame.new(0,-.4,0)*CFrame.Angles(0,0,math.rad(-20)); tool.Parent=backpack
 local h=p.Character and p.Character:FindFirstChildOfClass('Humanoid'); if h then h:EquipTool(tool) end
end
local hazardSerial=0
local function hazard(position)
 hazardSerial=hazardSerial+1
 local marker=Instance.new('Part'); marker.Name='UnstableDeposit'; marker.Shape=Enum.PartType.Cylinder
 marker.Size=Vector3.new(.12,16,16); marker.CFrame=CFrame.new(position.X,position.Y+2,position.Z)*CFrame.Angles(0,0,math.pi/2)
 marker.Color=Color3.fromRGB(255,118,92); marker.Material=Enum.Material.Neon; marker.Transparency=.35
 marker.Anchored=true; marker.CanCollide=false; marker.CanQuery=false; marker.Parent=world.Root
 for _,p in ipairs(Players:GetPlayers()) do
  local root=rootOf(p); if root and (root.Position-position).Magnitude&lt;32 then tell(p,'ТРЕСК ПОД НОГАМИ — отойди от красного круга!') end
 end
 task.delay(2.5,function()
  for _,p in ipairs(Players:GetPlayers()) do
   local root=rootOf(p)
   if root and (root.Position-position).Magnitude&lt;10 then root.Parent:FindFirstChildOfClass('Humanoid'):TakeDamage(38) end
  end
  local burst=Instance.new('Part'); burst.Shape=Enum.PartType.Ball; burst.Size=Vector3.new(1,1,1); burst.Position=position
  burst.Color=Color3.fromRGB(223,128,112); burst.Material=Enum.Material.Neon; burst.Anchored=true; burst.CanCollide=false; burst.CanQuery=false; burst.Parent=world.Root
  Tween:Create(burst,TweenInfo.new(.5),{Size=Vector3.new(16,16,16),Transparency=1}):Play()
  marker:Destroy(); game:GetService('Debris'):AddItem(burst,.7)
 end)
end
local function makeBlock(x,z,layer)
 local b=Instance.new('Part'); b.Name='Слой '..layer
 b.Size=Vector3.new(Layout.BlockSize,2.5,Layout.BlockSize); b.Position=Vector3.new(x,Layout.LayerY(layer),z)
 b.Color=({Color3.fromRGB(97,101,109),Color3.fromRGB(75,86,100),Color3.fromRGB(86,75,106)})[layer]
 b.Material=layer==1 and Enum.Material.Sand or Enum.Material.Slate
 b.Anchored=true; b:SetAttribute('Layer',layer); b:SetAttribute('HP',layer+1); b:SetAttribute('MaxHP',layer+1)
 b:SetAttribute('Hazard',rng:NextNumber()&lt;.085)
 b:SetAttribute('Find',rng:NextNumber()&lt;.075)
 b.Parent=blocks
end
if #blocks:GetChildren()==0 then
 for _,zone in ipairs(Layout.Zones) do
  for ix=0,Layout.PatchCells-1 do for iz=0,Layout.PatchCells-1 do for layer=1,3 do
   local x,z=zone.x-64+8+ix*Layout.BlockSize,zone.z-64+8+iz*Layout.BlockSize
   if not (math.abs(x-zone.x)&lt;16 and z&gt;=zone.z+32) then makeBlock(x,z,layer) end
  end end end
 end
else
 for _,b in ipairs(blocks:GetChildren()) do
  if b:IsA('BasePart') then
   local layer=math.clamp(math.floor((Layout.LayerY(1)-b.Position.Y)/2.5+.5)+1,1,3)
   b.Name='Слой '..layer; b:SetAttribute('Layer',layer); b:SetAttribute('HP',layer+1); b:SetAttribute('MaxHP',layer+1)
   b:SetAttribute('Hazard',rng:NextNumber()&lt;.085); b:SetAttribute('Find',rng:NextNumber()&lt;.075)
  end
 end
end
local depleted={}
local cleared=0
local function totalCapacity(d) return C.Tools[d.tool].capacity end
local function dig(p,b,auto,point)
 local d=state(p); local root=rootOf(p)
 if not d or not root or typeof(b)~='Instance' or not b:IsA('BasePart') then return end
 local natural=b.Parent==world.Root and b.Name=='LunarRegolith'
 if not natural and b.Parent~=blocks then return end
 if natural then
  if typeof(point)~='Vector3' or point.X~=point.X or point.Y~=point.Y or point.Z~=point.Z then return end
  if (root.Position-point).Magnitude&gt;18 then return end
  local delta=point-b.Position
  if math.abs(delta.X)&gt;b.Size.X/2+.1 or math.abs(delta.Y)&gt;b.Size.Y/2+.1 or math.abs(delta.Z)&gt;b.Size.Z/2+.1 then return end
 else
  if (root.Position-b.Position).Magnitude&gt;18 then return end
 end
 local equipped=root.Parent:FindFirstChildOfClass('Tool')
 if not auto and (not equipped or not equipped:GetAttribute('UnderlayerTool')) then tell(p,d.tutorial.step==0 and 'Получи щётку на учебной стойке.' or 'Выбери инструмент на панели снизу: клавиша 1.'); return end
 local training=math.abs(b.Position.X)&lt;70 and math.abs(b.Position.Z-Layout.TrainingZ)&lt;60
 if not training and d.tutorial.step&lt;7 then tell(p,'Сначала заверши задания учебного отдела.'); return end
 local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={p.Character,petsFolder}
 local origin=root.Position+Vector3.new(0,1,0)
 local direction=(natural and point or b.Position)-origin
 local hit=workspace:Raycast(origin,direction.Magnitude&gt;0 and direction.Unit*(direction.Magnitude+.2) or Vector3.new(0,-1,0),params)
 if not hit or hit.Instance~=b then return end
 if natural then
  if d.bag&gt;=totalCapacity(d) then tell(p,'Рюкзак полон. Сдай добычу.'); return end
  local center=b.Position
  b:Destroy()
  for _,cell in ipairs(Layout.TileCells(center.X,center.Z)) do makeBlock(cell.x,cell.z,cell.layer) end
  return
 end
 local layer=b:GetAttribute('Layer')
 if not training and d.bag&gt;=totalCapacity(d) then if not auto then tell(p,'Рюкзак полон. Вернись к терминалу в лагере.') end; return end
 local hp=b:GetAttribute('HP')-(auto and 1 or C.Tools[d.tool].power)
 if hp&gt;0 then b:SetAttribute('HP',hp); return end
 local pos=b.Position; local find=not training and b:GetAttribute('Find'); local danger=not training and b:GetAttribute('Hazard')
 if not training then table.insert(depleted,{x=pos.X,z=pos.Z,layer=layer}) end
 b:Destroy(); if not training then cleared=cleared+1 end
 local t=d.tutorial
 if training and t.step==1 and layer==1 then
  t.soft=t.soft+1; if t.soft&gt;=3 then t.step=2; tell(p,'Пыль снята. Получи скребок на стойке.') end
 elseif training and t.step==3 and layer==2 then
  t.hard=t.hard+1; if t.hard&gt;=2 then t.step=4; tell(p,'Под коркой найден кокон! Осмотри его справа от участка.') end
 elseif not training and t.step==7 then
  t.field=t.field+1; if t.field&gt;=12 then t.step=8; tell(p,'Вернись к генератору базы. На ремонт нужно 80 монет.') end
 end
 d.bag=math.min(totalCapacity(d),d.bag+3+layer*2)
 local before=C.Level(d.xp); d.xp=d.xp+5+layer*2
 local level=C.Level(d.xp)
 local changed=false
 for _,id in ipairs(d.equipped) do
  local pet=d.pets[id]
  if pet and pet.growth&lt;math.min(level,50) then
   pet.growth=math.min(level,50,pet.growth+.14); changed=true
  end
 end
 if level&gt;before then tell(p,'УРОВЕНЬ '..level..' • малыши могут вырасти ещё!') end
 if find then
  local ids={'Dust','Moss','Crystal'}; local id=ids[rng:NextInteger(1,#ids)]
  if d.pets[id] then
   d.pets[id].fragments=d.pets[id].fragments+1
   tell(p,'Найден фрагмент: '..C.Pets[id].name..'. 5 фрагментов открывают светлый окрас.')
  else d.pets[id]={growth=1,fragments=0}; tell(p,'В коконе спал '..C.Pets[id].name..'! Открой коллекцию.') end
 end
 if danger then hazard(pos) end
 if changed then
  local u=sessions[p]
  if os.clock()-(u.lastRebuild or 0)&gt;5 then u.lastRebuild=os.clock(); rebuild(p) end
 end
 if not training and cleared==90 then
  for _,pl in ipairs(Players:GetPlayers()) do tell(pl,'Под коркой обнаружена древняя капсула. Центральный сектор изменился.') end
  local capsule=Instance.new('Part'); capsule.Name='AncientCapsule'; capsule.Shape=Enum.PartType.Ball
  capsule.Size=Vector3.new(9,13,9); capsule.Position=Vector3.new(Layout.Zones[1].x,1,Layout.Zones[1].z); capsule.Material=Enum.Material.Neon
  capsule.Color=Color3.fromRGB(126,137,184); capsule.Anchored=true; capsule.Parent=world.Root
  local prompt=Instance.new('ProximityPrompt'); prompt.ActionText='Освободить малыша'; prompt.ObjectText='Древняя капсула'; prompt.HoldDuration=2; prompt.MaxActivationDistance=13; prompt.Parent=capsule
  local claimed={}
  prompt.Triggered:Connect(function(pl)
   local dd=state(pl); local rr=rootOf(pl)
   if not dd or not rr or (rr.Position-capsule.Position).Magnitude&gt;17 or claimed[pl.UserId] then return end
   claimed[pl.UserId]=true
   if not dd.pets.Crystal then dd.pets.Crystal={growth=1,fragments=0} else dd.pets.Crystal.fragments=dd.pets.Crystal.fragments+2 end
   dd.xp=dd.xp+100; tell(pl,'Кристик освобождён. +100 опыта.'); sync(pl)
  end)
 end
 sync(p)
end
local function connectDepot(prompt)
 prompt.Triggered:Connect(function(p)
  local d=state(p); local root=rootOf(p)
  if not d or not root or (root.Position-prompt.Parent.Position).Magnitude&gt;16 then return end
  local amount=d.bag; d.coins=d.coins+amount*2; d.bag=0
  sync(p); tell(p,'Сдано '..amount..' ресурсов • +'..(amount*2)..' монет')
 end)
end
for _,obj in ipairs(world.Root:GetDescendants()) do
 if obj:IsA('ProximityPrompt') and obj.Name=='SellPrompt' then connectDepot(obj) end
end
local function teach(p,obj)
 local d=state(p); local r=rootOf(p)
 if not d or not r or (r.Position-obj.Position).Magnitude&gt;18 then return end
 local t=d.tutorial
 if obj.Name=='TrainingRack' then
  if t.step==0 then t.step=1; tell(p,'Щётка в руках. Подойди к учебному участку и удерживай ЛКМ на пыли.')
  elseif t.step==2 then d.tool=math.max(d.tool,2); t.step=3; tell(p,'Скребок получен. Сними 2 блока камня под пылью.') end
  giveTool(p)
 elseif obj.Name=='TrainingNest' then
  if t.step~=4 then tell(p,'Сначала выполни текущее учебное задание.'); return end
  d.pets.Dust=d.pets.Dust or {growth=1,fragments=0}; d.equipped={'Dust'}; t.step=5
  rebuild(p); tell(p,'Это Пылик. Он растёт вместе с твоим уровнем. Теперь сдай добычу в терминале.')
 elseif obj.Name=='TrainingSell' then
  local amount=d.bag; d.coins=d.coins+amount*2; d.bag=0
  if t.step==5 then t.step=6; tell(p,'Первая оплата получена. Заверши обучение у шлюза.')
  else tell(p,'Добыча сдана. Продолжи текущее учебное задание.') end
 elseif obj.Name=='TrainingExit' then
  if t.step&lt;6 then tell(p,'Выполни учебное задание перед выходом.'); return end
  if t.step==6 then t.step=7 end
  r.CFrame=CFrame.new(0,5,Layout.CampZ); tell(p,'База экспедиции заброшена. Очисти 12 залежей первого участка и восстанови генератор.')
 elseif obj.Name=='BaseGenerator' then
  if t.step~=8 then tell(p,'Сначала очисти 12 залежей экспедиции.'); return end
  if d.coins&lt;80 then tell(p,'На ремонт нужно 80 монет. Сдай добычу в любом пункте.'); return end
  d.coins=d.coins-80; t.step=9; tell(p,'Генератор восстановлен. База снова принимает сигналы.')
 end
 sync(p)
end
for _,obj in ipairs(world.Root:GetDescendants()) do
 if obj:IsA('ProximityPrompt') and obj.Name=='TeachPrompt' then obj.Triggered:Connect(function(p) teach(p,obj.Parent) end) end
end
world.Upgrade.Triggered:Connect(function(p)
 local d=state(p); local root=rootOf(p)
 if not d or not root or (root.Position-world.Upgrade.Parent.Position).Magnitude&gt;16 then return end
 local nextTool=C.Tools[d.tool+1]
 if not nextTool then tell(p,'Бур уже максимального уровня.'); return end
 if d.coins&lt;nextTool.cost then tell(p,nextTool.name..': нужно '..nextTool.cost..' монет.'); return end
 d.coins=d.coins-nextTool.cost; d.tool=d.tool+1; giveTool(p); sync(p); tell(p,'Получен '..nextTool.name..'!')
end)
local function givePet(d,id)
 if d.pets[id] then d.pets[id].fragments=d.pets[id].fragments+1 else d.pets[id]={growth=1,fragments=0} end
end
local function eggRoll()
 local n=rng:NextNumber(0,100); local sum=0
 for _,o in ipairs(C.EggOdds) do sum=sum+o.chance; if n&lt;sum then return o.id end end
 return C.EggOdds[#C.EggOdds].id
end
local function productKind(id)
 if id==0 then return nil end
 if id==C.EggProduct then return 'egg' end
 for pet,product in pairs(C.DirectProducts) do if id==product then return pet end end
end
Market.ProcessReceipt=function(receipt)
 local p=Players:GetPlayerByUserId(receipt.PlayerId)
 local s=p and Profile.Live[p]; local u=p and sessions[p]
 local kind=productKind(receipt.ProductId)
 if not p or not s or not u or s.offline or not kind then return Enum.ProductPurchaseDecision.NotProcessedYet end
 while s.busy and p.Parent do task.wait(.1) end
 if not p.Parent or s.saveFailed then return Enum.ProductPurchaseDecision.NotProcessedYet end
 local ok=Profile.Commit(p,function(d)
  if d.receipts[receipt.PurchaseId] then return end
  if kind=='egg' then d.eggs=d.eggs+1 else givePet(d,kind) end
  d.receipts[receipt.PurchaseId]=true
 end)
 if not ok then return Enum.ProductPurchaseDecision.NotProcessedYet end
 sync(p); tell(p,kind=='egg' and 'Яйцо добавлено в коллекцию. Открой его в магазине.' or 'Малыш добавлен в коллекцию!')
 return Enum.ProductPurchaseDecision.PurchaseGranted
end
Market.PromptGamePassPurchaseFinished:Connect(function(p,id,purchased)
 if purchased and (id==C.HelpPass or id==C.SlotsPass) then task.defer(refreshEntitlements,p) end
end)
local function onPlayer(p)
 sessions[p]={models={},help=false,slots=false,policy=false,lastAction=0,lastDig=0}
 local s,err=Profile.Load(p)
 if not s then sessions[p]=nil; p:Kick(err); return end
 if not p.Parent then Profile.WaitSave(p,true); Profile.Live[p]=nil; sessions[p]=nil; return end
 local u=sessions[p]
 -- Paid items are disabled in local Studio, so don't block gameplay on a policy request.
 if not Run:IsStudio() then
  local ok,policy=pcall(Policy.GetPolicyInfoForPlayerAsync,Policy,p)
  if ok then u.policy=policy.ArePaidRandomItemsRestricted==false end
 end
 local function character(ch)
  local hum=ch:WaitForChild('Humanoid'); hum.WalkSpeed=18; hum.UseJumpPower=false; hum.JumpHeight=10
  local root=ch:WaitForChild('HumanoidRootPart')
  local head=ch:WaitForChild('Head')
  local shell=Instance.new('Part'); shell.Name='HelmetFlashlight'; shell.Size=Vector3.new(.48,.3,.28)
  shell.CFrame=head.CFrame*CFrame.new(0,.25,-.63); shell.Material=Enum.Material.Metal; shell.Color=Color3.fromRGB(50,58,65)
  shell.CanCollide=false; shell.CanTouch=false; shell.Massless=true; shell.Parent=ch
  local weld=Instance.new('WeldConstraint'); weld.Part0=head; weld.Part1=shell; weld.Parent=shell
  local flashlight=Instance.new('SpotLight'); flashlight.Name='PersonalFlashlight'; flashlight.Face=Enum.NormalId.Front
  flashlight.Angle=85; flashlight.Range=68; flashlight.Brightness=2.2; flashlight.Color=Color3.fromRGB(241,233,214); flashlight.Shadows=true; flashlight.Parent=shell
  local spawn=world.Root:FindFirstChild('CampSpawn')
  root.CFrame=s.data.tutorial.step&lt;7 and CFrame.new(-25,5,Layout.TrainingZ) or CFrame.new(0,5,Layout.CampZ)
  if s.data.tutorial.step&gt;0 then giveTool(p) end
  hum.Died:Connect(function()
   local live=Profile.Live[p]
   if not live then return end
   -- Wait out an in-flight durable purchase before changing the same profile.
   while live.busy do task.wait(.05) end
   local d=live.data; local lost=math.ceil(d.bag*.25); d.bag=d.bag-lost
   tell(p,'Экстренная эвакуация. Потеряно '..lost..' несданных ресурсов.'); sync(p)
  end)
  task.delay(.8,function() if sessions[p] then rebuild(p); sync(p) end end)
 end
 p.CharacterAdded:Connect(character)
 if p.Character then task.spawn(character,p.Character) end
 refreshEntitlements(p); sync(p)
 if s.offline then tell(p,'РЕЖИМ STUDIO: сохранение недоступно. Прогресс временный, покупки отключены.') end
end
Players.PlayerAdded:Connect(onPlayer)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer,p) end
Players.PlayerRemoving:Connect(function(p)
 Profile.WaitSave(p,true)
 local u=sessions[p]; if u then for _,m in ipairs(u.models) do m:Destroy() end end
 sessions[p]=nil; Profile.Live[p]=nil
end)
event.OnServerEvent:Connect(function(p,action,arg,point)
 local u=sessions[p]; local d=state(p)
 if not u or not d then return end
 if action=='sync' then if os.clock()-(u.lastSync or 0)&lt;1 then return end; u.lastSync=os.clock(); sync(p); return end
 if action=='dig' then
  if os.clock()-u.lastDig&lt;.32 then return end; u.lastDig=os.clock(); dig(p,arg,false,point); return
 end
 if os.clock()-u.lastAction&lt;.4 then return end; u.lastAction=os.clock()
 if action=='home' then
  local r=rootOf(p); if r then r.CFrame=CFrame.new(-25,5,Layout.TrainingZ); tell(p,'Учебный отдел. Через шлюз можно вернуться в экспедицию.') end
 elseif action=='equip' then
  if typeof(arg)~='string' or not d.pets[arg] then return end
  local found=table.find(d.equipped,arg)
  if found then table.remove(d.equipped,found)
  elseif #d.equipped&lt;(u.slots and 3 or 1) then table.insert(d.equipped,arg)
  else tell(p,'Все места заняты. Сначала убери выбранного спутника.'); return end
  rebuild(p); sync(p)
 elseif action=='buy' then
  if Profile.Live[p].offline then tell(p,'Покупки отключены в режиме без сохранения.'); return end
  if arg=='help' or arg=='slots' then
   local id=arg=='help' and C.HelpPass or C.SlotsPass
   if id&lt;=0 then tell(p,'Покупка ещё не настроена создателем.'); return end
   if (arg=='help' and u.help) or (arg=='slots' and u.slots) then tell(p,'Уже приобретено.'); return end
   Market:PromptGamePassPurchase(p,id)
  else
   local id=0
   if arg=='egg' then
    if not u.policy then tell(p,'Платные случайные яйца недоступны для этого аккаунта. Выбери конкретного малыша.'); return end
    id=C.EggProduct
   elseif typeof(arg)=='string' then id=C.DirectProducts[arg] or 0 end
   if id&lt;=0 then tell(p,'Покупка ещё не настроена создателем.'); return end
   Market:PromptProductPurchase(p,id)
  end
 elseif action=='hatch' then
  if not u.policy or Profile.Live[p].offline or d.eggs&lt;1 then tell(p,'Нет доступного яйца или открытие недоступно.'); return end
  local id=eggRoll()
  local ok=Profile.Commit(p,function(dd) dd.eggs=dd.eggs-1; givePet(dd,id) end)
  if ok then tell(p,'Из яйца появился '..C.Pets[id].name..'! Повтор даёт фрагмент окраса.'); sync(p) end
 end
end)
local tickTime=0
Run.Heartbeat:Connect(function(dt)
 tickTime=tickTime+dt; if tickTime&lt;.05 then return end
 local step=tickTime; tickTime=0
 for p,u in pairs(sessions) do
  local r=rootOf(p)
  if r then
   if r.Position.Y &lt; -35 then r.CFrame=CFrame.new(-25,5,Layout.TrainingZ); r.AssemblyLinearVelocity=Vector3.zero; tell(p,'Аварийный возврат в учебный отдел.') end
   for i,m in ipairs(u.models) do
    if m.PrimaryPart then
     local x=(i-(#u.models+1)/2)*3
     local target=r.CFrame*CFrame.new(x,.2+math.sin(os.clock()*3+i)*.25,4)
     m:PivotTo(m:GetPivot():Lerp(target,1-math.exp(-7*step)))
    end
   end
  end
 end
end)
task.spawn(function()
 while task.wait(3) do
  for p,u in pairs(sessions) do
   local r=rootOf(p)
   if u.help and #u.models&gt;0 and r then
    local nearest=nil; local distance=15
    for _,b in ipairs(blocks:GetChildren()) do
     local n=(b.Position-r.Position).Magnitude
     if n&lt;distance then distance=n; nearest=b end
    end
    if nearest then for _=1,#u.models do if nearest.Parent then dig(p,nearest,true) end end end
   end
  end
 end
end)
task.spawn(function()
 while task.wait(45) do for p in pairs(Profile.Live) do task.spawn(Profile.WaitSave,p,false) end end
end)
task.spawn(function()
 while task.wait(600) do
  -- Rare server-wide respawn: only three fully emptied columns, never inside a player.
  local count=0
  for index=#depleted,1,-1 do
   local spot=depleted[index]; local free=true
   for _,b in ipairs(blocks:GetChildren()) do if b.Position.X==spot.x and b.Position.Z==spot.z then free=false; break end end
   for _,p in ipairs(Players:GetPlayers()) do local r=rootOf(p); if r and (r.Position-Vector3.new(spot.x,r.Position.Y,spot.z)).Magnitude&lt;12 then free=false end end
   if free then
    for layer=1,3 do makeBlock(spot.x,spot.z,layer) end
    table.remove(depleted,index); count=count+1
    if count&gt;=3 then break end
   end
  end
  if count&gt;0 then for _,p in ipairs(Players:GetPlayers()) do tell(p,'Сканер: обнаружено '..count..' новых залежей.') end end
 end
end)
game:BindToClose(function()
 local pending=0
 for p in pairs(Profile.Live) do pending=pending+1; task.spawn(function() Profile.WaitSave(p,true); pending=pending-1 end) end
 local deadline=os.clock()+25; while pending&gt;0 and os.clock()&lt;deadline do task.wait(.1) end
end)

-- Large landscape generation cannot block profiles, tools or the first tutorial.
task.spawn(function()
 local ok,err=pcall(function() require(script.Parent.TerrainWorld).Build(world.Root) end)
 if not ok then warn("Outer landscape: ",err) end
end)
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX7039"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX7040"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX7041"><Properties><string name="Name">UnderlayerClient</string><ProtectedString name="Source">local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local Market=game:GetService('MarketplaceService')
local Tween=game:GetService('TweenService')
local player=Players.LocalPlayer
local F=RS:WaitForChild('Underlayer'); local C=require(F.Config); local Visual=require(F.PetVisual)
local Layout=require(F.Layout)
local event=F:WaitForChild('Action'); local data=nil
local gui=Instance.new('ScreenGui'); gui.Name='UnderlayerUI'; gui.ResetOnSpawn=false; gui.IgnoreGuiInset=false; gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; gui.Parent=player:WaitForChild('PlayerGui')
local palette={bg=Color3.fromRGB(20,23,28),panel=Color3.fromRGB(32,37,43),line=Color3.fromRGB(62,70,78),text=Color3.fromRGB(232,233,229),muted=Color3.fromRGB(158,166,172),accent=Color3.fromRGB(172,198,181),gold=Color3.fromRGB(226,191,126)}
local function corner(obj,n) local c=Instance.new('UICorner'); c.CornerRadius=UDim.new(0,n or 4); c.Parent=obj end
local function frame(parent,size,pos,color)
 local f=Instance.new('Frame'); f.Size=size; f.Position=pos; f.BackgroundColor3=color or palette.panel; f.BorderSizePixel=0; f.Parent=parent; corner(f); return f
end
local function label(parent,size,pos,txt,n,color)
 local l=Instance.new('TextLabel'); l.BackgroundTransparency=1; l.Size=size; l.Position=pos; l.Text=txt; l.TextColor3=color or palette.text
 l.Font=Enum.Font.GothamMedium; l.TextSize=n or 16; l.TextXAlignment=Enum.TextXAlignment.Left; l.TextWrapped=true; l.Parent=parent; return l
end
local function button(parent,size,pos,txt,callback,color)
 local b=Instance.new('TextButton'); b.Size=size; b.Position=pos; b.Text=txt; b.Font=Enum.Font.GothamBold; b.TextSize=14; b.TextColor3=palette.bg
 b.BackgroundColor3=color or palette.accent; b.AutoButtonColor=true; b.BorderSizePixel=0; b.Parent=parent; corner(b,4)
 b.Activated:Connect(callback); return b
end
-- Compact HUD: information stays in the corners; the world remains unobstructed.
local top=frame(gui,UDim2.fromOffset(274,102),UDim2.fromOffset(18,14),palette.bg)
top.BackgroundTransparency=.16
label(top,UDim2.new(1,-28,0,20),UDim2.fromOffset(14,9),'UNDERLAYER  /  07',12,palette.muted)
local stats=label(top,UDim2.new(1,-28,0,38),UDim2.fromOffset(14,31),'Подключение к экспедиции…',14)
local levelText=label(top,UDim2.new(1,-28,0,16),UDim2.fromOffset(14,76),'',10,palette.muted)
local xpBack=frame(top,UDim2.new(1,-28,0,2),UDim2.fromOffset(14,96),palette.line)
local xpBar=frame(xpBack,UDim2.fromScale(0,1),UDim2.fromScale(0,0),palette.accent)
local toast=frame(gui,UDim2.new(.8,0,0,48),UDim2.new(.1,0,1,-155),palette.bg)
local toastText=label(toast,UDim2.new(1,-24,1,0),UDim2.fromOffset(12,0),'',13)
toast.Visible=false
local help=label(gui,UDim2.fromOffset(310,30),UDim2.new(0,18,1,-98),'ЛКМ — копать    E — сдать    Shift — бег',11,palette.muted)
local cross=label(gui,UDim2.fromOffset(18,18),UDim2.new(.5,-9,.5,-9),'·',24,palette.text); cross.TextXAlignment=Enum.TextXAlignment.Center
local targetText=label(gui,UDim2.fromOffset(300,32),UDim2.new(.5,-150,.5,20),'',12); targetText.TextXAlignment=Enum.TextXAlignment.Center
local nav=frame(gui,UDim2.fromOffset(330,40),UDim2.new(0,18,1,-60),palette.bg)
nav.BackgroundTransparency=.12
local modal=frame(gui,UDim2.new(.94,0,.71,0),UDim2.fromScale(.03,.19),palette.bg); modal.Visible=false
local title=label(modal,UDim2.new(1,-80,0,48),UDim2.fromOffset(18,0),'',22,palette.accent)
button(modal,UDim2.fromOffset(40,34),UDim2.new(1,-52,0,8),'×',function() modal.Visible=false end)
local content=Instance.new('ScrollingFrame'); content.Size=UDim2.new(1,-28,1,-64); content.Position=UDim2.fromOffset(14,54); content.BackgroundTransparency=1; content.BorderSizePixel=0
content.AutomaticCanvasSize=Enum.AutomaticSize.Y; content.CanvasSize=UDim2.new(); content.ScrollBarThickness=5; content.ScrollBarImageColor3=palette.accent; content.Parent=modal
local list=Instance.new('UIListLayout'); list.Padding=UDim.new(0,10); list.SortOrder=Enum.SortOrder.LayoutOrder; list.Parent=content
local padding=Instance.new('UIPadding'); padding.PaddingBottom=UDim.new(0,14); padding.PaddingRight=UDim.new(0,6); padding.Parent=content
local mission=label(gui,UDim2.fromOffset(300,80),UDim2.fromOffset(18,165),'ПОЛУЧИ ЗАДАНИЕ В УЧЕБНОМ ОТДЕЛЕ',14,palette.text)
local waypoint=Instance.new('BillboardGui'); waypoint.Size=UDim2.fromOffset(150,44); waypoint.StudsOffset=Vector3.new(0,5,0); waypoint.AlwaysOnTop=true; waypoint.MaxDistance=600; waypoint.Parent=gui
local waypointText=label(waypoint,UDim2.fromScale(1,1),UDim2.new(),'▼ ЦЕЛЬ',14,palette.gold); waypointText.TextXAlignment=Enum.TextXAlignment.Center
local currentPage=''; local previewStage=1
local selectedPreview='Dust'; local previewModel=nil; local spin=0
local products={}; local fetchPending={}
local function price(id,isPass)
 if not id or id&lt;=0 then return 'Не настроено' end
 local key=tostring(id)..tostring(isPass)
 if products[key] then return products[key] end
 if not fetchPending[key] then
  fetchPending[key]=true
  task.spawn(function()
   local ok,info=pcall(Market.GetProductInfoAsync,Market,id,isPass and Enum.InfoType.GamePass or Enum.InfoType.Product)
   products[key]=ok and info and info.PriceInRobux and (tostring(info.PriceInRobux)..' R$') or 'Цена в окне Roblox'
   fetchPending[key]=nil
  end)
 end
 return 'Цена в окне Roblox'
end
local function clear()
 previewModel=nil
 for _,child in ipairs(content:GetChildren()) do if child:IsA('Frame') or child:IsA('TextLabel') then child:Destroy() end end
 content.CanvasPosition=Vector2.zero
end
local function row(height)
 local r=frame(content,UDim2.new(1,0,0,height),UDim2.new(),palette.panel); return r
end
local function viewport(parent,id,growth,size,pos)
 local v=Instance.new('ViewportFrame'); v.Size=size; v.Position=pos; v.BackgroundTransparency=1
 v.Ambient=Color3.fromRGB(182,194,211); v.LightColor=Color3.fromRGB(245,231,215); v.LightDirection=Vector3.new(-1,-1,-1); v.Parent=parent
 local world=Instance.new('WorldModel'); world.Parent=v
 local m=Visual.Build(id,C.Pets[id],growth)
 -- Remove overhead nameplates from the 3D preview.
 for _,desc in ipairs(m:GetDescendants()) do if desc:IsA('BillboardGui') then desc:Destroy() end end
 m.Parent=world
 local camera=Instance.new('Camera'); camera.CFrame=CFrame.lookAt(Vector3.new(6,4,-11),Vector3.new(0,.6,.4)); camera.FieldOfView=40; camera.Parent=v; v.CurrentCamera=camera
 return m
end
local function buy(key) event:FireServer('buy',key) end
local render
render=function(page)
 currentPage=page; clear(); modal.Visible=true
 if page=='collection' then
  title.Text='Коллекция / рост малышей'
  if not data then label(row(60),UDim2.fromScale(1,1),UDim2.new(),'Загрузка...',16); return end
  local info=row(60)
  label(info,UDim2.new(1,-24,1,0),UDim2.fromOffset(12,0),'Активных: '..#data.equipped..'/'..data.slots..' • бесплатный спутник следует за тобой. Помощь в добыче — отдельный пропуск.',13,palette.muted)
  local preview=row(240)
  local grow=({1,6,15,30,50})[previewStage]
  previewModel=viewport(preview,selectedPreview,grow,UDim2.new(.45,0,1,-20),UDim2.fromOffset(0,10))
  label(preview,UDim2.new(.53,-12,0,55),UDim2.new(.46,0,0,12),C.Pets[selectedPreview].name..' / просмотр роста',18)
  label(preview,UDim2.new(.53,-12,0,60),UDim2.new(.46,0,0,68),'Уровни: 1 → 6 → 15 → 30 → 50\nСтадия '..previewStage..' из 5',13,palette.muted)
  button(preview,UDim2.new(.49,0,0,40),UDim2.new(.46,0,0,145),'Следующая стадия',function() previewStage=previewStage%5+1; render('collection') end)
  label(preview,UDim2.new(.53,-12,0,40),UDim2.new(.46,0,0,190),'Это предпросмотр, он не меняет питомца.',11,palette.muted)
  for _,id in ipairs({'Dust','Moss','Crystal','Nova','Umbra','Sol'}) do
   local def=C.Pets[id]; local owned=data.pets[id]; local r=row(126)
   viewport(r,id,owned and owned.growth or 1,UDim2.new(.22,0,1,0),UDim2.new())
   label(r,UDim2.new(.76,-10,0,30),UDim2.new(.23,0,0,8),def.name..(def.premium and ' • особый' or ''),16,def.color)
   label(r,UDim2.new(.76,-10,0,35),UDim2.new(.23,0,0,38),owned and ('Рост '..string.format('%.1f',owned.growth)..' / '..data.level..' • фрагменты '..owned.fragments) or (def.premium and 'Покупка в магазине' or 'Спит в одном из коконов'),12,palette.muted)
   button(r,UDim2.new(.34,0,0,34),UDim2.new(.23,0,0,82),'Посмотреть рост',function() selectedPreview=id; previewStage=1; render('collection') end)
   if owned then
    button(r,UDim2.new(.34,0,0,34),UDim2.new(.61,0,0,82),table.find(data.equipped,id) and 'Убрать' or 'Взять с собой',function() event:FireServer('equip',id) end)
   end
  end
 elseif page=='shop' then
  title.Text='Магазин экспедиции'
  local intro=row(94)
  label(intro,UDim2.new(1,-24,1,0),UDim2.fromOffset(12,0),'Бесплатно: раскопки, все три инструмента, уровень и три вида малышей. За Robux: помощь, особые малыши и 3 активных спутника. Предметы не обмениваются.',14,palette.muted)
  for _,entry in ipairs({{key='help',name='Помощь малышей',desc='Каждый активный малыш наносит 1 урон залежи рядом раз в 3 секунды.',id=C.HelpPass},{key='slots',name='Три спутника',desc='Три активных малыша вместо одного. Коллекция всегда без ограничения.',id=C.SlotsPass}}) do
   local r=row(128)
   label(r,UDim2.new(1,-24,0,30),UDim2.fromOffset(12,8),entry.name,18)
   label(r,UDim2.new(1,-24,0,40),UDim2.fromOffset(12,40),entry.desc,13,palette.muted)
   button(r,UDim2.new(1,-24,0,32),UDim2.fromOffset(12,87),price(entry.id,true),function() buy(entry.key) end)
  end
  for _,id in ipairs({'Nova','Umbra','Sol'}) do
   local r=row(145); viewport(r,id,10,UDim2.new(.25,0,1,0),UDim2.new())
   label(r,UDim2.new(.71,0,0,30),UDim2.new(.27,0,0,10),C.Pets[id].name..' • конкретный малыш',17,C.Pets[id].color)
   label(r,UDim2.new(.71,0,0,38),UDim2.new(.27,0,0,43),'Гарантированный вид. Повтор: +1 фрагмент светлого окраса.',12,palette.muted)
   button(r,UDim2.new(.34,0,0,38),UDim2.new(.27,0,0,94),price(C.DirectProducts[id],false),function() buy(id) end)
   button(r,UDim2.new(.32,0,0,38),UDim2.new(.64,0,0,94),'Стадии роста',function() selectedPreview=id; previewStage=1; render('collection') end)
  end
  local egg=row(208)
  label(egg,UDim2.new(1,-24,0,36),UDim2.fromOffset(12,8),'Кристальное яйцо',20,palette.gold)
  local odds={}; for _,o in ipairs(C.EggOdds) do table.insert(odds,C.Pets[o.id].name..' — '..o.chance..'%') end
  label(egg,UDim2.new(1,-24,0,56),UDim2.fromOffset(12,44),table.concat(odds,'   /   ')..'\nПовтор даёт 1 фрагмент окраса. 5 фрагментов → светлый окрас.',13)
  local allowed=data and data.eggAllowed
  button(egg,UDim2.new(1,-24,0,36),UDim2.fromOffset(12,108),allowed and ('Купить яйцо • '..price(C.EggProduct,false)) or 'Случайные покупки недоступны',function() if allowed then buy('egg') end end,allowed and palette.gold or palette.muted)
  button(egg,UDim2.new(1,-24,0,36),UDim2.fromOffset(12,156),'Открыть яйцо • в наличии '..(data and data.eggs or 0),function() event:FireServer('hatch') end,palette.accent)
 elseif page=='journal' then
  title.Text='Журнал экспедиции'
  for _,entry in ipairs({
   {'01 / ПЕРВАЯ СМЕНА','Спустись с лагеря к серой корке. Наведи курсор на блок и удерживай ЛКМ. На телефоне используй кнопку «Копать».'},
   {'02 / РЕСУРСЫ','У каждого участка есть пункт сдачи. Инструменты улучшаются на верстаке в главном лагере. Shift — бег. Указатель под панелью ведёт к ближайшим раскопкам.'},
   {'03 / НЕ БУДИТЬ','Если под землёй раздаётся треск и появляется красный круг, отойди. Через 2,5 секунды случится выброс. При гибели теряется 25% несданного.'},
   {'04 / СПЯЩИЕ','Иногда под коркой прячутся малыши. Возьми найденного спутника с собой: он постепенно растёт до твоего уровня, пока ты раскапываешь залежи.'},
   {'05 / ГЛУБИНА','Двенадцать участков на равнине 3072 × 3072. Слои: пыль → камень → корка. После 90 блоков капсула появится на первом участке.'},
   {'06 / ПЛАНЕТА ПОМНИТ','Внутри одного сервера раскопки общие. Раз в 10 минут возвращаются до трёх залежей. На новом сервере поверхность создаётся заново.'},
  }) do local r=row(136); label(r,UDim2.new(1,-24,0,32),UDim2.fromOffset(12,8),entry[1],16,palette.accent); label(r,UDim2.new(1,-24,0,86),UDim2.fromOffset(12,43),entry[2],14,palette.muted) end
 end
end
for i,item in ipairs({{'Малыши','collection'},{'Магазин','shop'},{'Журнал','journal'}}) do
 button(nav,UDim2.new(1/3,-10,0,28),UDim2.new((i-1)/3,5,0,6),item[1],function() if modal.Visible and currentPage==item[2] then modal.Visible=false else render(item[2]) end end)
end
button(gui,UDim2.fromOffset(160,30),UDim2.new(1,-178,1,-60),'В учебный отдел',function() event:FireServer('home') end,palette.muted)
for _,b in ipairs(nav:GetChildren()) do
 if b:IsA('TextButton') then b.BackgroundColor3=palette.panel; b.TextColor3=palette.text; b.TextSize=12 end
end
local function character(ch)
 local h=ch:WaitForChild('Humanoid')
 h.CameraOffset=Vector3.new(2,1,0)
 player.CameraMinZoomDistance=6; player.CameraMaxZoomDistance=22
 player.CameraMode=Enum.CameraMode.Classic
 task.wait(.3)
 local cam=workspace.CurrentCamera
 cam.CameraType=Enum.CameraType.Custom; cam.CameraSubject=h
 local r=ch:FindFirstChild('HumanoidRootPart')
 if r then cam.CFrame=CFrame.lookAt(r.Position+Vector3.new(12,9,-17),r.Position+Vector3.new(0,2,0)) end
end
player.CharacterAdded:Connect(character); if player.Character then task.spawn(character,player.Character) end
local holding=false; local target=nil; local lastDig=0; local mouse=player:GetMouse()
local function sprint(on)
 local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
 if h then h.WalkSpeed=on and 30 or 18 end
end
local route=label(gui,UDim2.fromOffset(310,34),UDim2.fromOffset(18,124),'',12,palette.muted)
local aimPoint=nil
local function rayTarget()
 aimPoint=nil
 local cam=workspace.CurrentCamera; if not cam then return nil end
 local ray
 if UIS.TouchEnabled and not UIS.MouseEnabled then ray=cam:ViewportPointToRay(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
 else
  local pos=UIS:GetMouseLocation(); ray=cam:ScreenPointToRay(pos.X,pos.Y)
 end
 local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
 local omit={}; if player.Character then table.insert(omit,player.Character) end
 local world=workspace:FindFirstChild('UnderlayerWorld'); if world and world:FindFirstChild('Companions') then table.insert(omit,world.Companions) end
 params.FilterDescendantsInstances=omit
 local result=workspace:Raycast(ray.Origin,ray.Direction*150,params)
 if result and result.Instance.Parent and (result.Instance.Parent.Name=='Deposits' or result.Instance.Name=='LunarRegolith') then aimPoint=result.Position; return result.Instance end
 return nil
end
local selection=Instance.new('Highlight'); selection.FillColor=palette.accent; selection.FillTransparency=.84; selection.OutlineColor=palette.accent; selection.DepthMode=Enum.HighlightDepthMode.Occluded; selection.Parent=workspace.CurrentCamera
UIS.InputBegan:Connect(function(input,processed)
 if not processed and input.KeyCode==Enum.KeyCode.LeftShift then sprint(true) end
 if not processed and input.UserInputType==Enum.UserInputType.MouseButton1 then holding=true end
 if not processed and input.KeyCode==Enum.KeyCode.B then render('collection') end
end)
UIS.InputEnded:Connect(function(input)
 if input.UserInputType==Enum.UserInputType.MouseButton1 then holding=false end
 if input.KeyCode==Enum.KeyCode.LeftShift then sprint(false) end
end)
UIS.WindowFocusReleased:Connect(function() holding=false; sprint(false) end)
local digButton=button(gui,UDim2.fromOffset(112,56),UDim2.new(1,-130,1,-132),'Копать',function() if not modal.Visible then local b=rayTarget(); if b then event:FireServer('dig',b,aimPoint) end end end)
digButton.Visible=UIS.TouchEnabled
local toastToken=0
local function message(txt)
 toastToken=toastToken+1; local token=toastToken
 toastText.Text=txt; toast.Visible=true
 task.delay(8,function() if token==toastToken then toast.Visible=false end end)
end
event.OnClientEvent:Connect(function(action,payload)
 if action=='message' then message(payload)
 elseif action=='data' then
  data=payload
  local tool=C.Tools[data.tool]
  stats.Text='Уровень '..data.level..'    •    '..data.coins..' монет\n'..tool.name..'    /    '..data.bag..' из '..tool.capacity
  local floor=45*(data.level-1)^2; local ceiling=45*data.level^2
  xpBar.Size=UDim2.fromScale(math.clamp((data.xp-floor)/(ceiling-floor),0,1),1)
  levelText.Text=data.offline and 'Тестовый запуск • без сохранения' or ('Опыт '..data.xp)
  if modal.Visible and currentPage=='collection' then render('collection') elseif modal.Visible and currentPage=='shop' then render('shop') end
 end
end)
local accum=0; local nextRoute=0
Run.RenderStepped:Connect(function(dt)
 if previewModel and previewModel.Parent then spin=spin+dt*.4; previewModel:PivotTo(CFrame.Angles(0,spin,0)) end
 accum=accum+dt; if accum&lt;.05 then return end; accum=0
 if os.clock()&gt;nextRoute then
  nextRoute=os.clock()+.25
  local r=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  if r then
   local nearest,dist=nil,math.huge
   for _,zone in ipairs(Layout.Zones) do
    local n=(r.Position-Vector3.new(zone.x,0,zone.z)).Magnitude
    if n&lt;dist then dist=n; nearest=zone end
   end
   local t=data and data.tutorial
   local task=t and C.Missions[t.step]
   local world=workspace:FindFirstChild('UnderlayerWorld')
   local objective=world and task and world:FindFirstChild(task.target)
   waypoint.Adornee=objective
   if task then
    local count=t.step==1 and (' • '..t.soft..'/3') or t.step==3 and (' • '..t.hard..'/2') or t.step==7 and (' • '..t.field..'/12') or ''
    mission.Text='ТЕКУЩЕЕ ЗАДАНИЕ\n'..task.text..count
   end
   if objective then
    local meters=math.floor((r.Position-objective.Position).Magnitude*.28)
    route.Text='К цели: '..meters..' м'; waypointText.Text='▼ ЦЕЛЬ • '..meters..' м'
   else route.Text=nearest and (nearest.name..' • '..math.floor(dist*.28)..' м') or '' end
  end
 end
 target=not modal.Visible and rayTarget() or nil; selection.Adornee=target
 targetText.Text=target and (target.Name=='LunarRegolith' and 'Лунный грунт • можно копать' or ('Слой '..tostring(target:GetAttribute('Layer'))..' • '..tostring(target:GetAttribute('HP'))..' / '..tostring(target:GetAttribute('MaxHP')))) or ''
 if holding and not modal.Visible and target and os.clock()-lastDig&gt;.36 then lastDig=os.clock(); event:FireServer('dig',target,aimPoint) end
end)
task.spawn(function()
 for _=1,15 do if data then return end; event:FireServer('sync'); task.wait(1) end
 stats.Text='Мир загружен, сервер не отвечает'
 message('Скрипт игры не запустился. Открой View → Output и посмотри первую красную ошибку.')
end)
